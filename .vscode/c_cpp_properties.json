{
    // c_cpp_properties.json — IntelliSense 配置
    //
    // 关键: compileCommands 指向 CMake 导出的 compile_commands.json。
    // 那个文件里记录了每个源文件的真实编译参数(标准、宏、头文件路径),
    // 所以 IntelliSense 与实际编译永远一致 —— 不需要手写 includePath。
    // 这是目前 C/C++ 工程的主流做法。
    //
    // 前提: 先跑一次 CMake 配置 (Ctrl+Shift+B 的默认任务会做),
    //       生成 build/compile_commands.json。
    "version": 4,
    "configurations": [
        {
            "name": "Linux x86-64 (compile_commands.json)",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "configurationProvider": "ms-vscode.cpptools",
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}
