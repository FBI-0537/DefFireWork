# Dockerfile.build-armhf — 在容器内交叉编译本项目
#
# 为什么用 COPY 而不用 bind mount:
#   常规做法是 `docker run -v <仓库>:/work` 把源码挂进容器。但在部分环境下
#   (实测 podman + 受限沙箱) 挂载进来的目录**只读**, 报:
#       mkdir: cannot create directory '/work/build-armhf/CMakeFiles': Permission denied
#   这与 SELinux / 目录属主无关 —— 干净的 user_home_t 目录同样写不了。
#
#   COPY 把源码复制进镜像层, 完全不依赖挂载, 因此在任何环境都能构建。
#   代价: 每次都是全量编译(模板改了就要重编 LVGL), 换不来增量构建。
#
# 产物在 /work/build-armhf/, 由 build-armhf.sh 用 `podman cp` 取回宿主。
#
# 不需要单独调用 —— ./armhf-toolchain/build-armhf.sh 会自动用它。

# 交叉编译环境镜像(先由 Dockerfile 构建出来)
ARG BASE_IMAGE=firecontrol-armhf:bookworm
FROM ${BASE_IMAGE}

# 源码复制进来。注意 .dockerignore 会排除 .git/build* 等, 保持镜像精简。
COPY CMakeLists.txt lv_conf.h /work/
COPY armhf-toolchain/ /work/armhf-toolchain/
COPY src/ /work/src/
COPY tests/ /work/tests/
COPY third_party/ /work/third_party/

WORKDIR /work

# 配置 + 编译。失败就让层失败, 不会产出半个镜像。
RUN set -eux; \
    cmake -B /work/build-armhf -S /work \
          -DCMAKE_TOOLCHAIN_FILE=/work/armhf-toolchain/toolchain-docker-armhf.cmake \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -DWITH_GUI=ON; \
    cmake --build /work/build-armhf -j "$(nproc)"; \
    echo "=== 产物 ==="; \
    ls -la /work/build-armhf/halloworld-gui /work/build-armhf/halloworld 2>/dev/null || true; \
    for f in /work/build-armhf/halloworld-gui /work/build-armhf/halloworld; do \
        [ -f "$$f" ] || continue; \
        arm-linux-gnueabihf-readelf -h "$$f" | grep -E 'Class:|Machine:|Flags:' | sed 's/^/    /'; \
    done
